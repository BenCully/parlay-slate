# TypeSafe key used by jev-recipes (rerank + verify).
# Create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Price source. Leave it blank to read FanDuel, DraftKings, BetMGM, and Caesars.
# fanduel, draftkings, betmgm, or caesars reads that one Illinois book.
# the-odds-api only replays odds saved before the live Odds API call was removed.
# Formula 1 always reads FanDuel.
ODDS_SOURCE=

# /v1 base for model=tail-jev (alias model=autojev). The client posts to systemone
# on this base. Put the address in .env only. Do not commit it.
AUTOJEV_URL=

# Bearer token for that server. Required for model=tail-jev. Do not commit it.
AUTOJEV_API_KEY=
