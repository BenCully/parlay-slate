# TypeSafe key used by jev-recipes (rerank + verify).
# Create one at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# The Odds API key used to pull the day's moneyline slate.
# Create one at https://the-odds-api.com
ODDS_API_KEY=

# Price source. Leave it blank for The Odds API, which needs ODDS_API_KEY.
# fanduel, draftkings, betmgm, and caesars read that book's Illinois sportsbook
# and need no Odds API key. books reads all four and keeps each book's price.
# Formula 1 always reads FanDuel, including when this is the-odds-api or books.
ODDS_SOURCE=

# /v1 base for model=tail-jev (alias model=autojev). The client posts to systemone
# on this base. Put the address in .env only. Do not commit it.
AUTOJEV_URL=

# Bearer token for that server. Required for model=tail-jev. Do not commit it.
AUTOJEV_API_KEY=
