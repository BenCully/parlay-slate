# Odds cache settings. Copy this file to .env.settings.
# Keys stay in .env. This file is gitignored after you copy it.
# A name set in .env overrides the same name here.

# How long a saved Odds API response is reused, in hours. 168 is 7 days.
ODDS_CACHE_HOURS=168

# Set to 0 to ignore the cache and spend credits.
# npm start -- --fresh does the same for one run.
ODDS_CACHE=1

# Folder for saved responses. Leave this unset to use ./odds-cache next to the script.
# ODDS_CACHE_DIR=
