{
  "name": "parlays",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.settings --env-file-if-exists=.env --import tsx parlays.ts",
