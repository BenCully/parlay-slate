{
  "name": "parlays",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.settings --env-file-if-exists=.env --import tsx scripts/start.ts",
    "slate": "node --env-file-if-exists=.env.settings --env-file-if-exists=.env --import tsx scripts/parlays.ts",
    "tui": "node --env-file-if-exists=.env.settings --env-file-if-exists=.env --import tsx scripts/tui.ts",
    "view": "node --import tsx scripts/view.ts",
    "odds": "node --env-file-if-exists=.env.settings --env-file-if-exists=.env --import tsx scripts/odds-days.ts",
    "compare": "node --import tsx scripts/compare.ts",
    "clear-snapshots": "node --import tsx scripts/clear-snapshots.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "jev-recipes": "^0.9.17"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
