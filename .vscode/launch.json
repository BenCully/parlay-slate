{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start slate",
      "program": "${workspaceFolder}/scripts/start.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--env-file-if-exists=${workspaceFolder}/.env.settings",
        "--env-file-if-exists=${workspaceFolder}/.env",
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run slate",
      "program": "${workspaceFolder}/scripts/parlays.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--env-file-if-exists=${workspaceFolder}/.env.settings",
        "--env-file-if-exists=${workspaceFolder}/.env",
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Open TUI",
      "program": "${workspaceFolder}/scripts/tui.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--env-file-if-exists=${workspaceFolder}/.env.settings",
        "--env-file-if-exists=${workspaceFolder}/.env",
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start slate for an Eastern day",
      "program": "${workspaceFolder}/scripts/parlays.ts",
      "cwd": "${workspaceFolder}",
      "args": ["${input:slateDate}"],
      "runtimeArgs": [
        "--env-file-if-exists=${workspaceFolder}/.env.settings",
        "--env-file-if-exists=${workspaceFolder}/.env",
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Replay saved odds",
      "program": "${workspaceFolder}/scripts/parlays.ts",
      "cwd": "${workspaceFolder}",
      "args": ["odds=${input:oddsDay}", "model=${input:decisionModel}"],
      "runtimeArgs": [
        "--env-file-if-exists=${workspaceFolder}/.env.settings",
        "--env-file-if-exists=${workspaceFolder}/.env",
        "--import",
        "tsx"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Compare decision snapshots",
      "program": "${workspaceFolder}/scripts/compare.ts",
      "cwd": "${workspaceFolder}",
      "args": ["${input:compareDay}"],
      "runtimeArgs": ["--import", "tsx"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "View saved slate",
      "program": "${workspaceFolder}/scripts/view.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--import", "tsx"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "slateDate",
      "type": "promptString",
      "description": "America/New_York day as YYYY-MM-DD. Sunday night is included. Monday night is not."
    },
    {
      "id": "oddsDay",
      "type": "promptString",
      "description": "Eastern day the odds were saved, YYYY-MM-DD. npm run odds lists them."
    },
    {
      "id": "decisionModel",
      "type": "pickString",
      "description": "Decision model.",
      "options": ["jev", "tail-jev"],
      "default": "jev"
    },
    {
      "id": "compareDay",
      "type": "promptString",
      "description": "Snapshot day to compare, YYYY-MM-DD."
    }
  ]
}
